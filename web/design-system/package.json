{
  "name": "@axioledger/axio-design-system",
  "version": "6.0.0",
  "description": "AXQ Design System — React component library with 3-layer token architecture, TLP namespace security, and ANS resolver integration. (Unified v6)",
  "license": "MIT",
  "author": "Axioledger Engineering <engineering@axioledger.io>",
  "homepage": "https://github.com/axioledger/axioledger-monorepo/tree/main/design-system",
  "repository": {
    "type": "git",
    "url": "https://github.com/axioledger/axioledger-monorepo.git",
    "directory": "design-system"
  },
  "bugs": {
    "url": "https://github.com/axioledger/axioledger-monorepo/issues"
  },
  "keywords": [
    "design-system",
    "react",
    "axioledger",
    "axq",
    "tokens",
    "css-custom-properties",
    "tlp",
    "ans",
    "web3",
    "crypto-ui"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./styles":             "./dist/styles.css",
    "./fonts":              "./dist/fonts.css",
    "./tokens":             "./tokens/variables.css",
    "./tokens/primitive":   "./tokens/primitive.css",
    "./tokens/semantic":    "./tokens/semantic.css",
    "./tokens/component":   "./tokens/component.css",
    "./tokens/tailwind":    "./tokens/tailwind-tokens.js",
    "./tokens/js":          "./src/tokens.ts",
    "./sprites":            "./public/sprites/icons.svg"
  },
  "files": [
    "dist",
    "public/sprites",
    "tokens/variables.css",
    "tokens/primitive.css",
    "tokens/semantic.css",
    "tokens/component.css",
    "tokens/tailwind-tokens.js",
    "tokens/color-tokens.json",
    "tokens/typography-tokens.json",
    "tokens/icon-tokens.css",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "dist/styles.css",
    "dist/fonts.css",
    "tokens/variables.css",
    "tokens/primitive.css",
    "tokens/semantic.css",
    "tokens/component.css"
  ],
  "scripts": {
    "prep:icons":         "node scripts/generate-sprite.cjs",
    "build:tokens":       "node scripts/build-tokens.cjs",
    "build:tokens:check": "node scripts/build-tokens.cjs --check",
    "check:hex":          "node scripts/check-hardcoded-hex.cjs",
    "build:lib":          "vite build --config vite.lib.config.ts",
    "build:types":        "tsc --project tsconfig.lib.json",
    "build":              "pnpm run build:lib && pnpm run build:types",
    "dev":             "storybook dev -p 6006",
    "storybook":       "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test":            "jest --passWithNoTests",
    "test:watch":      "jest --watch",
    "test:coverage":   "jest --coverage",
    "lint":            "eslint src --ext .ts,.tsx",
    "typecheck":       "tsc --noEmit",
    "prepublishOnly":  "pnpm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": false },
    "react-dom": { "optional": false }
  },
  "dependencies": {},
  "devDependencies": {
    "@storybook/addon-a11y": "^8.0.0",
    "@storybook/addon-essentials": "^8.0.0",
    "@storybook/addon-themes": "^8.0.0",
    "@storybook/react-vite": "^8.0.0",
    "@storybook/testing-library": "^0.2.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "storybook": "^8.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
